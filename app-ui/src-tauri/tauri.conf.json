{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apex LLM",
  "version": "0.9.0",
  "identifier": "app.apexllm.android",
  "build": {
    "beforeDevCommand": "npm --prefix ../web-showcase run dev",
    "beforeBuildCommand": "npm --prefix ../web-showcase run build:app",
    "devUrl": "http://localhost:3000/app",
    "frontendDist": "../../web-showcase/out"
  },
  "app": {
    "windows": [{ "title": "Apex LLM", "width": 420, "height": 880, "resizable": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "android": { "minSdkVersion": 26 }
  }
}
